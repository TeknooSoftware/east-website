{
    "name": "teknoo/east-website",
    "type": "library",
    "description": "Universal package, following the #East programming philosophy, build on Teknoo/East-Foundation (and Teknoo/Recipe), and implementing a basic CMS to display dynamics pages with different types and templates.",
    "keywords": ["east","website","cms"],
    "homepage": "https://teknoo.software/east-collection/website",
    "license": ["BSD-3-Clause"],
    "authors": [
        {
            "name": "Richard Déloge",
            "email": "richard@teknoo.software",
            "role": "Software architect, Lead developer"
        }
    ],
    "support": {
        "issues": "https://github.com/TeknooSoftware/east-website/issues",
        "source": "https://github.com/TeknooSoftware/east-website"
    },
    "funding": [
        {
            "type": "patreon",
            "url": "https://www.patreon.com/teknoo_software"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/TeknooSoftware"
        }
    ],
    "autoload": {
        "psr-4": {
            "Teknoo\\East\\Website\\": "src/",
            "Teknoo\\East\\WebsiteBundle\\": "infrastructures/symfony",
            "Teknoo\\East\\Website\\Doctrine\\": "infrastructures/doctrine",
            "Teknoo\\East\\Website\\Twig\\": "infrastructures/twig",
            "Teknoo\\Tests\\East\\Website\\": "tests/universal",
            "Teknoo\\Tests\\East\\WebsiteBundle\\": "tests/infrastructures/symfony",
            "Teknoo\\Tests\\East\\Website\\Doctrine\\": "tests/infrastructures/doctrine",
            "Teknoo\\Tests\\East\\Website\\Twig\\": "tests/infrastructures/twig"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Teknoo\\Tests\\East\\Website\\Behat\\": "tests/behat"
        }
    },
    "config": {
        "audit": {
            "abandoned": "report"
        },
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "php-di/php-di": "^7.1.1",
        "teknoo/immutable": "^3.0.22",
        "teknoo/states": "^7.1.11",
        "teknoo/recipe": "^7.3",
        "teknoo/east-common": "^4.6.1",
        "teknoo/east-foundation": "^9.2.4",
        "teknoo/east-translation": "^2.1"
    },
    "require-dev": {
        "ext-simplexml" : "*",
        "ext-mongodb" : "*",
        "roave/security-advisories": "dev-latest",
        "phpunit/phpunit": "^13",
        "squizlabs/php_codesniffer": "^4.0.1",
        "phpstan/phpstan": "^2.2.2",
        "phpstan/extension-installer": "^1.4.3",
        "symfony/property-access": "^6.4.24||^7.4||^8.1",
        "behat/behat": "^4.0",
        "behat/phpunit-assertions-extension": "^1.0",
        "teknoo/bridge-phpdi-symfony": "^7.1.2",
        "psr/cache": "^3",
        "guzzlehttp/guzzle": "^7.15.1||^8",
        "symfony/cache": "^6.4.24||^7.4||^8.1",
        "symfony/cache-contracts": "^3.6",
        "symfony/clock": "^6.4.24||^7.4||^8.1",
        "symfony/config": "^6.4.24||^7.4||^8.1",
        "symfony/console": "^6.4.24||^7.4||^8.1",
        "symfony/finder": "^6.4.24||^7.4||^8.1",
        "symfony/error-handler": "^6.4.24||^7.4||^8.1",
        "symfony/var-exporter": "^6.4.24||^7.4||^8.1",
        "symfony/dependency-injection": "^6.4.24||^7.4||^8.1",
        "symfony/event-dispatcher": "^6.4.24||^7.4||^8.1",
        "symfony/event-dispatcher-contracts": "^3.6",
        "symfony/form": "^6.4.24||^7.4||^8.1",
        "symfony/framework-bundle": "^6.4.24||^7.4||^8.1",
        "symfony/filesystem": "^6.4.24||^7.4||^8.1",
        "symfony/http-kernel": "^6.4.24||^7.4||^8.1",
        "symfony/html-sanitizer": "^6.4.24||^7.4||^8.1",
        "symfony/options-resolver": "^6.4.24||^7.4||^8.1",
        "symfony/psr-http-message-bridge": "^6.4.24||^7.4||^8.1",
        "symfony/password-hasher": "^6.4.24||^7.4||^8.1",
        "symfony/polyfill-intl-icu": "^1.30",
        "symfony/polyfill-php83": "^1.30",
        "symfony/property-info": "^6.4.24||^7.4||^8.1",
        "symfony/routing": "^6.4.24||^7.4||^8.1",
        "symfony/security-core": "^6.4.24||^7.4||^8.1",
        "symfony/security-csrf": "^6.4.24||^7.4||^8.1",
        "symfony/security-http": "^6.4.24||^7.4||^8.1",
        "symfony/security-bundle": "^6.4.24||^7.4||^8.1",
        "symfony/serializer": "^6.4.24||^7.4||^8.1",
        "symfony/string": "^6.4.24||^7.4||^8.1",
        "symfony/translation": "^6.4.24||^7.4||^8.1",
        "symfony/translation-contracts": "^3.6.1",
        "symfony/twig-bridge": "^7.4||^8.1",
        "symfony/twig-bundle": "^7.4||^8.1",
        "symfony/uid": "^6.4.24||^7.4||^8.1",
        "symfony/validator": "^6.4.24||^7.4||^8.1",
        "symfony/yaml": "^6.4.24||^7.4||^8.1",
        "symfony/var-dumper": "^6.4.24||^7.4||^8.1",
        "twig/twig": "^3.23",
        "laminas/laminas-diactoros": "^3.8",
        "doctrine/common": "^3.5",
        "doctrine/mongodb-odm": "^2.16.1",
        "doctrine/mongodb-odm-bundle": "^5.6",
        "doctrine/persistence": "^4.1.1",
        "league/uri": "^7.8",
        "league/oauth2-client": "^2.9",
        "masterminds/html5": "^2.7.5",
        "knpuniversity/oauth2-client-bundle": "^2.20.1"
    },
    "suggest": {
        "symfony/serializer": "Required to use the JSON API (with `framework.serializer.enabled: true`).",
        "symfony/twig-bundle": "Required to use the JSON API and its templates."
    },
    "conflict": {
        "doctrine/persistence": "<3.0"
    },
    "archive": {
        "exclude": ["features", "tests", "tools", "vendor", ".idea"]
    },
    "extra": {
        "thanks": {
            "name": "teknoo/east-foundation",
            "url": "https://github.com/TeknooSoftware/east-foundation"
        }
    }
}
