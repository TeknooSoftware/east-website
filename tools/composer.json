{
    "name": "teknoo/east-website-cli",
    "type": "project",
    "description": "Command line client (Symfony Console + phar) for the remote JSON API of Teknoo East Website.",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Richard Déloge",
            "email": "richard@teknoo.software",
            "role": "Software architect, Lead developer"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "psr/clock": "^1",
        "symfony/console": "^7.4||^8.1",
        "symfony/http-client": "^7.4||^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.2",
        "phpunit/phpunit": "^13",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "autoload": {
        "psr-4": {
            "Teknoo\\East\\Website\\Tools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Teknoo\\Tests\\East\\Website\\Tools\\": "tests/unit/",
            "Teknoo\\Tests\\East\\Website\\Tools\\Support\\": "tests/support/",
            "Teknoo\\Tests\\East\\Website\\Tools\\Phar\\": "tests/phar/",
            "Teknoo\\Tests\\East\\Website\\Tools\\E2E\\": "tests/e2e/"
        }
    },
    "bin": [
        "bin/east-website"
    ]
}
